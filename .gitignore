/server
/agentray
*.log
.DS_Store
web/node_modules
web/.next

# Local env files (real test/provider credentials — never commit)
.env
.env.*
!.env.example

# Bench run artifacts — generated by agent runs (reports, solutions, sample
# audio). The harness itself (bench/*_test.go, bench/cmd, bench/judge,
# bench/PROBLEM*.md) is source and stays tracked.
bench/results/
bench/solutions/
/air-tmp/

# Stray vitest cache at the repo root (the web app has its own node_modules)
/node_modules

# SDK build artefacts and installs. Lockfiles ARE committed — CI publishes from
# them, and an SDK that resolves a different dependency tree than the one its
# tests ran against is not the artefact that was verified.
sdk/*/node_modules
sdk/*/dist
sdk/python/dist
sdk/python/*.egg-info
__pycache__/
sdk/swift/.build
