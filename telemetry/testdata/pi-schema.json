      "input": {
        "name": "cross-schema parentage",
        "actions": [
          {
            "op": "span",
            "name": "operation",
            "attributes": {
              "kind": "read"
            },
            "actions": [
              {
                "op": "span",
                "name": "request",
                "attributes": {
                  "provider": "example"
                },
                "actions": [
                  {
                    "op": "attributes",
                    "attributes": {
                      "response": "cached"
                    }
                  },
                  {
                    "op": "event",
                    "name": "result",
                    "attributes": {
                      "outcome": "ok"
                    }
                  }
                ],
                "result": 42
              }
            ],
            "result": 42
          }
        ]
      },
      "expected": {
