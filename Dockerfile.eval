# Portable persistent-eval runtime for hosted AgentRay deployments.
#
# The runtime supplies only Node.js and Python. AgentRay's DockerSandbox adds
# the actual security envelope at launch: no network, read-only root, dropped
# capabilities, no-new-privileges, resource caps, writable tmpfs HOME, and a
# single writable workspace mount. Keeping this image narrow avoids coupling
# eval to the much larger computer-use document toolchain.

FROM node:22.23.2-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/usr/local/bin:/usr/bin:/bin

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates python3; \
    rm -rf /var/lib/apt/lists/*; \
    node --version; \
    python3 --version

USER 65534:65534
WORKDIR /workspace

# No ENTRYPOINT/CMD: ProcessSandbox supplies the language-specific argv.
