# Copy to .env (gitignored) and fill with real local values. Never commit .env.
#   set -a && . ./.env && set +a
#   /usr/local/go/bin/go test ./internal/... -run 'TestReal_|RealProvider' -v -count=1

# OpenAI-compatible endpoint for the env-gated real-provider agent tests.
# Tests skip (not fail) when these are unset, so CI stays green without creds.
AGENTRAY_TEST_OPENAI_BASE_URL=http://localhost:PORT/v1
AGENTRAY_TEST_OPENAI_API_KEY=sk-your-local-key
AGENTRAY_TEST_OPENAI_MODEL=your-model

# Hosted default model pool. When set, a new workspace can ask without pasting
# a key (BYOK still overrides). If unset, AGENTRAY_TEST_OPENAI_* is reused for
# the key + base URL so `make dev` answers on first ask.
# AGENTRAY_DEFAULT_MODEL_PROVIDER=openai
# AGENTRAY_DEFAULT_MODEL_BASE_URL=https://ai.example.com/v1
# AGENTRAY_DEFAULT_MODEL_API_KEY=sk-your-hosted-key
# AGENTRAY_DEFAULT_MODEL_FLASH=flash
# AGENTRAY_DEFAULT_MODEL_LITE=plus
# AGENTRAY_DEFAULT_MODEL_PRO=pro

# In-process Go port of the Pi agent engine. No Bun/worker is used by the server.
# Opt in while OAuth account pools and fallback lifecycles are being migrated.
# AGENTRAY_AGENT_NATIVE_GO=true

# Sandbox images the computer_use / browser_use integration tests run in.
# Build: docker build --platform linux/amd64 -f Dockerfile.computeruse -t agentray-computeruse:latest .
#        docker build --platform linux/amd64 -f Dockerfile.browser      -t agentray-browser:latest .
AGENTRAY_SANDBOX_COMPUTER_USE_IMAGE=agentray-computeruse:latest
AGENTRAY_SANDBOX_BROWSER_IMAGE=agentray-browser:latest

# Secret used to derive the AES-GCM key (SHA-256) that encrypts per-agent provider
# API keys at rest. Required for the chat/agent runtime to read or store agent keys.
# Use any high-entropy string locally; set a real managed secret in prod. Rotating it
# makes already-stored keys undecryptable, so rotate deliberately.
AGENT_KEY_ENC_SECRET=replace-with-a-random-secret

# Required before external PostgreSQL connectors may dial. This absolute,
# operator-owned JSON file contains exact host/port/IP and export-view bindings,
# never DSNs or passwords. Empty denies external dials. See docs/SOURCE-EXPORTS.md.
# AGENTRAY_SOURCE_POLICY_FILE=/etc/agentray/source-policy.json

# Disposable databases used only by the source/snapshot integration suite.
# Never point these at production. The source URL must be able to create a
# temporary restricted role and export fixture; tests fail (rather than skip)
# when an explicitly configured URL is unusable.
# AGENTRAY_TEST_DATABASE_URL=postgres://...
# AGENTRAY_TEST_SOURCE_DATABASE_URL=postgres://...

# The shared demo: the id of a REAL project, on a site this instance's operator
# runs, that every account is auto-added to as a read-only member. The project's
# owning workspace IS the demo workspace, so point this at a project that sits in
# a workspace you are willing to share whole. Empty — the default, and every
# `docker compose up` — means this instance has no demo; nothing synthetic is
# ever generated to stand in for one.
# AGENTRAY_DEMO_PROJECT_ID=
#
# How many questions one visitor may ask the agent inside that demo per day
# (UTC). Demo runs bill THIS instance's model key, not the visitor's, so this is
# a spend control: the ceiling is what stands between a shared demo and an
# unbounded bill. 0 switches the demo agent off for visitors rather than
# uncapping it. Ignored entirely when there is no demo project.
# AGENTRAY_DEMO_AGENT_RUNS_PER_USER_PER_DAY=5
