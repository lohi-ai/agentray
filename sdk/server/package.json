{
  "name": "@agentray/server",
  "version": "0.2.0",
  "description": "AgentRay server SDK \u2014 awaitable, idempotent event capture for revenue truth (payments, subscriptions, refunds).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "analytics",
    "product-analytics",
    "revenue",
    "server-side",
    "agentray"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "author": "LoHi",
  "homepage": "https://github.com/lohi-ai/agentray#readme",
  "bugs": {
    "url": "https://github.com/lohi-ai/agentray/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lohi-ai/agentray.git",
    "directory": "sdk/server"
  }
}
