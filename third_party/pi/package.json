{
  "name": "agentray-pi-reference",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "python3 verify.py",
    "test": "python3 verify.py --work && vitest run",
    "typecheck": "python3 verify.py --work && tsc --noEmit -p tsconfig.json",
    "prepare:reference": "python3 prepare.py && bun .work/packages/ai/scripts/generate-models.ts --data-only --strict",
    "build": "node runtime/build.mjs",
    "typecheck:runtime": "tsc --noEmit -p tsconfig.runtime.json",
    "test:runtime": "node --test runtime/*.test.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@aws-sdk/client-bedrock-runtime": "3.1127.0",
    "@google/genai": "2.21.0",
    "@smithy/node-http-handler": "4.12.1",
    "@types/node": "22.19.19",
    "esbuild": "0.28.2",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "openai": "7.19.0",
    "partial-json": "0.1.7",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
